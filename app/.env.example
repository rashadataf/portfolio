# Database
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Auth (generate with: openssl rand -base64 32)
AUTH_SECRET=your-super-secret-key-at-least-32-chars
AUTH_BASE_PATH=/api/auth
AUTH_TRUST_HOST=true

# Domain
DOMAIN_NAME=localhost
PROTOCOL=http
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email (for alerts)
ALERTMANAGER_EMAIL_TO=admin@example.com
ALERTMANAGER_EMAIL_FROM=noreply@example.com
ALERTMANAGER_SMTP_HOST=smtp.example.com
ALERTMANAGER_SMTP_PORT=587
ALERTMANAGER_SMTP_USERNAME=user
ALERTMANAGER_SMTP_PASSWORD=password

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure-password

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=secure-password

# Loki
LOKI_AUTH_USERNAME=
LOKI_AUTH_PASSWORD=

# Environment
ENV_TYPE=development